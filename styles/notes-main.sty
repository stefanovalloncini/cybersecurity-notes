\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes-main}[2026/11/14 Main layout and packages]

\RequirePackage[english]{babel}

% =============================================================
% Colours
% =============================================================
\RequirePackage{xcolor}
\definecolor{themeblue}  {RGB}{ 15,  75, 155}
\definecolor{themegreen} {RGB}{ 20, 115,  60}
\definecolor{themeorange}{RGB}{175,  80,  15}
\definecolor{themeviolet}{RGB}{100,  30, 150}
\definecolor{themegray}  {RGB}{ 90,  90,  95}
\definecolor{linkblue}   {RGB}{  0,  50, 150}

% =============================================================
% Page layout
% =============================================================
\RequirePackage[left=2cm,right=2cm,top=2cm,bottom=2cm]{geometry}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage[titles]{tocloft}
\RequirePackage{parskip}

\setlength{\emergencystretch}{3em}
\tolerance=1000
\hbadness=1500

\setlength{\headheight}{15pt}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\nouppercase{\leftmark}}
\fancyfoot[C]{\bfseries\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\footrule}{\vbox to 0pt{\hbox to \headwidth{\color{themeblue!25}\leaders\hrule height \footrulewidth\hfill}\vss}}

% --- Table of contents ---
\renewcommand{\cftpartfont}{\bfseries\large\color{themeblue}}
\renewcommand{\cftpartpagefont}{\bfseries\color{themeblue}}
\renewcommand{\cftpartleader}{}
\renewcommand{\cftpartafterpnum}{\cftparfillskip}
\setlength{\cftbeforepartskip}{12pt}

\renewcommand{\cftchapfont}{\bfseries\color{themeblue!85!black}}
\renewcommand{\cftchappagefont}{\bfseries\color{themeblue!85!black}}
\renewcommand{\cftchapleader}{\cftdotfill{\cftchapdotsep}}
\renewcommand{\cftchapdotsep}{2.5}
\setlength{\cftbeforechapskip}{5pt}

\renewcommand{\cftsecfont}{\color{black}}
\renewcommand{\cftsecpagefont}{\color{black}}
\renewcommand{\cftsecleader}{\color{black!30}\cftdotfill{\cftsecdotsep}}
\renewcommand{\cftsecdotsep}{4.0}

\renewcommand{\cftsubsecfont}{\small\color{black!80}}
\renewcommand{\cftsubsecpagefont}{\small\color{black!80}}
\renewcommand{\cftsubsecleader}{\color{black!20}\cftdotfill{\cftsubsecdotsep}}
\renewcommand{\cftsubsecdotsep}{4.0}

% --- Headings ---
\titleformat{\part}[display]
    {\centering\normalfont}
    {\color{themeblue!40}\large\scshape\partname~\thepart}
    {6pt}
    {\color{themeblue}\rule{0.25\textwidth}{0.6pt}\\[14pt]\LARGE\bfseries}
\titlespacing*{\part}{0pt}{0.3\textheight}{0pt}

\titleformat{\chapter}[block]
    {\normalfont\LARGE\bfseries}
    {\color{themeblue}\normalfont\normalsize\scshape\chaptername~\thechapter\enspace---\enspace}
    {0pt}
    {}
    [\vspace{4pt}{\color{themeblue!35}\rule{\linewidth}{0.8pt}}]
\titlespacing*{\chapter}{0pt}{20pt}{16pt}

\titleformat{\section}
    {\normalfont\large\bfseries\color{themeblue}}
    {\thesection}
    {0.7em}
    {}
    [\vspace{-3pt}{\color{themeblue!30}\rule{\linewidth}{0.4pt}}]
\titlespacing*{\section}{0pt}{14pt}{6pt}

\titleformat{\subsection}
    {\normalfont\normalsize\bfseries\color{themeblue!80!black}}
    {\thesubsection}
    {0.7em}
    {}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

% =============================================================
% Figures, tables, lists
% =============================================================
\RequirePackage{graphicx}
\graphicspath{{figures/}{../figures/}}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc,arrows.meta,shapes.geometric,fit,backgrounds,decorations.pathreplacing}

\captionsetup{
    font=small,
    labelfont={bf,color=themeblue},
    labelsep=period,
    skip=6pt,
}

\RequirePackage{booktabs}
\RequirePackage{tabularx}
\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{#1}}
\RequirePackage{multirow}
\renewcommand{\arraystretch}{1.3}

\RequirePackage{enumitem}
\setlist{topsep=4pt, itemsep=2pt, parsep=1pt}
\setlist[enumerate,1]{label=\arabic*.}
\setlist[enumerate,2]{label=\alph*)}

\RequirePackage{xurl}
\urlstyle{tt}

% =============================================================
% Maths
% =============================================================
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{amsthm}
\RequirePackage{thmtools}

% =============================================================
% Bibliography (biber; .bib found through BIBINPUTS, see Makefile)
% =============================================================
\RequirePackage[backend=biber,style=numeric,sorting=nyt,maxbibnames=4]{biblatex}
\addbibresource{references.bib}

% =============================================================
% Hyperlinks and cross-references
% =============================================================
\RequirePackage[
    colorlinks=true,
    linkcolor=linkblue,
    citecolor=linkblue,
    urlcolor=linkblue,
    linktoc=all,
    pdfdisplaydoctitle=true
]{hyperref}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage[nameinlink,capitalize,english]{cleveref}

% =============================================================
% Boxed environments
% =============================================================
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

\tcbset{
    notebox/.style={
        enhanced, breakable, sharp corners,
        frame hidden,
        borderline west={3pt}{0pt}{#1},
        left=10pt, right=8pt, top=6pt, bottom=6pt,
        before skip=8pt, after skip=6pt,
    },
}

% --- Theorem-like environments: \begin{definition}[Title] ... ---
\declaretheoremstyle[
    spaceabove=0pt, spacebelow=0pt,
    headfont=\bfseries\color{themeblue},
    notefont=\bfseries\color{themeblue},
    bodyfont=\normalfont, headpunct={.},
]{thm@blue}
\declaretheoremstyle[
    spaceabove=0pt, spacebelow=0pt,
    headfont=\bfseries\color{themegreen},
    notefont=\bfseries\color{themegreen},
    bodyfont=\normalfont, headpunct={.},
]{thm@green}
\declaretheoremstyle[
    spaceabove=0pt, spacebelow=0pt,
    headfont=\bfseries\color{themeorange},
    notefont=\bfseries\color{themeorange},
    bodyfont=\normalfont, headpunct={.},
]{thm@orange}
\declaretheoremstyle[
    spaceabove=0pt, spacebelow=0pt,
    headfont=\bfseries\color{themegray},
    notefont=\bfseries\color{themegray},
    bodyfont=\normalfont, headpunct={.},
]{thm@gray}

\declaretheorem[style=thm@green,  name=Definition, numberwithin=chapter]{definition}
\declaretheorem[style=thm@blue,   name=Theorem,    numberwithin=chapter]{theorem}
\declaretheorem[style=thm@orange, name=Example,    numberwithin=chapter]{example}
\declaretheorem[style=thm@gray,   name=Remark,     numbered=no]{remark}

\tcolorboxenvironment{definition}{notebox=themegreen,  colback=themegreen!7}
\tcolorboxenvironment{theorem}   {notebox=themeblue,   colback=themeblue!7}
\tcolorboxenvironment{example}   {notebox=themeorange, colback=themeorange!6}
\tcolorboxenvironment{remark}    {notebox=themegray!45, colback=white}

\renewenvironment{proof}[1][\proofname]{%
    \par\pushQED{\qed}\normalfont
    \trivlist
    \item[\hskip\labelsep\color{themeblue}\itshape #1\@addpunct{.}]\ignorespaces
}{%
    \popQED\endtrivlist\@endpefalse
}

% --- Exercises and solutions (solutions hidden with \showsolutionsfalse) ---
\newif\ifshowsolutions
\showsolutionstrue

\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\thechapter.\arabic{exercise}}

\newtcolorbox{exercise}{
    notebox=themeviolet, colback=themeviolet!5,
    before upper={\refstepcounter{exercise}%
        \textbf{\textcolor{themeviolet}{Exercise~\theexercise.}}\enspace},
}

\RequirePackage{comment}
\AtBeginDocument{%
    \ifshowsolutions
        \newtcolorbox{solution}{
            notebox=themegreen, colback=white,
            left=10pt, right=0pt, top=2pt, bottom=4pt,
            before upper={\textbf{\textcolor{themegreen}{Solution.}}\enspace},
        }%
    \else
        \excludecomment{solution}%
    \fi
}

% --- Section/chapter summary: \begin{summary}[Optional title] ... ---
\newtcolorbox{summary}[1][Summary]{
    enhanced, breakable, sharp corners,
    colback=themeblue!4, colframe=themeblue!50, boxrule=0.5pt,
    left=10pt, right=10pt, top=6pt, bottom=6pt,
    before skip=\bigskipamount, after skip=\medskipamount,
    title={\textbf{#1}}, coltitle=white,
    attach boxed title to top left={yshift=-0.1mm, xshift=-0.5pt},
    boxed title style={colback=themeblue!70, colframe=themeblue!70,
        boxrule=0pt, sharp corners, left=6pt, right=6pt, top=3pt, bottom=3pt},
}

% --- cleveref names (\cref gives "Definition 1.2") ---
\crefname{definition}{Definition}{Definitions}
\crefname{theorem}{Theorem}{Theorems}
\crefname{example}{Example}{Examples}
\crefname{exercise}{Exercise}{Exercises}
\crefname{algorithm}{Algorithm}{Algorithms}
\crefname{listing}{Listing}{Listings}

\RequirePackage{subfiles}

\endinput
