#!/bin/sh
# Block LaTeX accent commands in staged .tex files. Install with:
#   make install-hooks
set -e

staged=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(chapters|config)/.*\.tex$|^main\.tex$' || true)
[ -z "$staged" ] && exit 0

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }

ACCENT_RE='\\([`'"'"'"^~])\{?\\?[ieaouAEIOU]\}?|\{\\([`'"'"'"^~])[aeiouAEIOU]\}|\\c\{[cC]\}'

errors=0
for f in $staged; do
    matches=$(grep -nE "$ACCENT_RE" "$f" 2>/dev/null || true)
    if [ -n "$matches" ]; then
        red "LaTeX accent commands in $f:"
        echo "$matches" | sed 's/^/  /'
        echo "  use UTF-8 directly: à è ì ò ù À È Ì Ò Ù ä ï"
        errors=$((errors + 1))
    fi

    quotes=$(grep -nE '\x60\x60[^`]*'"''" "$f" 2>/dev/null || true)
    if [ -n "$quotes" ]; then
        yellow "Backtick-apostrophe quotes in $f (prefer \\enquote{...}):"
        echo "$quotes" | sed 's/^/  /'
    fi
done

if [ "$errors" -gt 0 ]; then
    red "Pre-commit failed: $errors file(s) violate the UTF-8 accent convention."
    exit 1
fi
